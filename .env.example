# ── Database ────────────────────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL=sqlite:///./chemrepro.db
# PostgreSQL for production (Railway sets this automatically):
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/chemrepro

# ── ORCID OAuth ──────────────────────────────────────────────────────────────
# Register at https://orcid.org/developer-tools
# Use the sandbox for local dev, production for live deployment.
ORCID_CLIENT_ID=APP-XXXXXXXXXXXX
ORCID_CLIENT_SECRET=your-orcid-client-secret
ORCID_REDIRECT_URI=http://localhost:8000/auth/callback
ORCID_ENV=sandbox   # sandbox | production

# ── Session security ─────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-hex-string

# ── Admin ────────────────────────────────────────────────────────────────────
# Token for the /admin login and HMAC-signed email links.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET_TOKEN=change-me-to-a-random-hex-string

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Sign up at https://resend.com: the free tier covers most use.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
FEEDBACK_NOTIFY_EMAIL=your-email@example.com
# Postal address printed in the footer of author notification emails (optional;
# leave empty until a non-home address is decided).
MAIL_POSTAL_ADDRESS=

# ── AI moderation (Anthropic) ────────────────────────────────────────────────
# Used for background AI content moderation of reviews and comments.
# Get a key at https://console.anthropic.com
# If not set, the AI layer is skipped; regex moderation still runs.
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx

# ── Site URL ─────────────────────────────────────────────────────────────────
# Used for generating absolute links in emails (opt-out, notifications).
SITE_URL=http://localhost:8000

# Where library PDFs/screenshots are stored. On Railway use a mounted Volume, e.g. /data/library
LIBRARY_DIR=library_files
