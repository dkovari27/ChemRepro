# Database
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/chemrepro

# ORCID OAuth (register at https://orcid.org/developer-tools)
ORCID_CLIENT_ID=APP-XXXXXXXXXXXX
ORCID_CLIENT_SECRET=your-secret-here
ORCID_REDIRECT_URI=http://localhost:8000/auth/callback

# Session security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-hex-string

# Set to "sandbox" during dev, "production" for live ORCID
ORCID_ENV=sandbox
